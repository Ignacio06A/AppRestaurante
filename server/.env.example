# Cadena de conexión a PostgreSQL
DATABASE_URL="postgresql://restaurante:restaurante@localhost:5432/restaurante?schema=public"
# Secreto para firmar los JWT (mínimo 32 caracteres en producción)
JWT_SECRET="cambie-este-secreto-por-uno-largo-y-aleatorio-123456"
JWT_EXPIRES_IN=12h
PORT=4000
# Origen(es) permitidos del frontend, separados por coma
CLIENT_ORIGIN="http://localhost:5173"
NODE_ENV=development
# Carpeta para imágenes subidas
UPLOAD_DIR=uploads
# Poner en 0 para no crear el historial de ventas de demostración al sembrar
SEED_DEMO=1
# Cookie de sesión solo por HTTPS (por defecto true en producción). Use false si sirve por HTTP en la red local.
# COOKIE_SECURE=false
