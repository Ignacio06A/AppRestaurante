// =============================================================
//  Sistema de Gestión de Restaurante — Modelo de datos
//  PostgreSQL + Prisma
//  Montos monetarios: Decimal(12,2). Nunca se borra información
//  financiera: productos, usuarios y mesas se desactivan (active=false).
// =============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------
//  Seguridad: usuarios, roles y permisos
// ---------------------------------------------------------------

model Role {
  id          Int              @id @default(autoincrement())
  code        String           @unique @db.VarChar(30) // ADMIN, WAITER, KITCHEN, BAR, CASHIER
  name        String           @db.VarChar(60)
  description String?          @db.VarChar(255)
  users       User[]
  permissions RolePermission[]
}

model Permission {
  id          Int              @id @default(autoincrement())
  code        String           @unique @db.VarChar(60)
  description String           @db.VarChar(255)
  module      String           @db.VarChar(40)
  roles       RolePermission[]
}

model RolePermission {
  roleId       Int
  permissionId Int
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model User {
  id           Int       @id @default(autoincrement())
  name         String    @db.VarChar(120)
  username     String    @unique @db.VarChar(60)
  passwordHash String
  roleId       Int
  role         Role      @relation(fields: [roleId], references: [id])
  active       Boolean   @default(true)
  tokenVersion Int       @default(0) // se incrementa para invalidar sesiones
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  ordersAsWaiter    Order[]          @relation("OrderWaiter")
  ordersClosed      Order[]          @relation("OrderClosedBy")
  batches           OrderBatch[]
  itemsCreated      OrderItem[]      @relation("ItemCreatedBy")
  itemsCancelled    OrderItem[]      @relation("ItemCancelledBy")
  history           OrderHistory[]
  payments          Payment[]
  cashOpened        CashSession[]    @relation("CashOpenedBy")
  cashClosings      CashClosing[]
  cashMovements     CashMovement[]   @relation("MovementUser")
  cashAuthorized    CashMovement[]   @relation("MovementAuthorizedBy")
  notifications     Notification[]
  auditLogs         AuditLog[]

  @@index([roleId])
}

// ---------------------------------------------------------------
//  Menú
// ---------------------------------------------------------------

model PreparationArea {
  id         Int         @id @default(autoincrement())
  code       String      @unique @db.VarChar(20) // KITCHEN | BAR
  name       String      @db.VarChar(60)
  products   Product[]
  categories Category[]
  orderItems OrderItem[]
}

model Category {
  id            Int              @id @default(autoincrement())
  name          String           @unique @db.VarChar(80)
  description   String?          @db.VarChar(255)
  sortOrder     Int              @default(0)
  active        Boolean          @default(true)
  defaultAreaId Int?
  defaultArea   PreparationArea? @relation(fields: [defaultAreaId], references: [id])
  products      Product[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
}

model Product {
  id          Int             @id @default(autoincrement())
  name        String          @db.VarChar(120)
  description String?         @db.VarChar(500)
  price       Decimal         @db.Decimal(12, 2)
  imageUrl    String?         @db.VarChar(500)
  categoryId  Int
  category    Category        @relation(fields: [categoryId], references: [id])
  areaId      Int
  area        PreparationArea @relation(fields: [areaId], references: [id])
  active      Boolean         @default(true) // desactivado = no visible, se conserva histórico
  available   Boolean         @default(true) // false = agotado
  sortOrder   Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  orderItems  OrderItem[]

  @@index([categoryId])
  @@index([areaId])
  @@index([active, available])
}

// ---------------------------------------------------------------
//  Salón: mesas
// ---------------------------------------------------------------

model DiningTable {
  id        Int      @id @default(autoincrement())
  number    Int      @unique
  name      String   @db.VarChar(60)
  zone      String?  @db.VarChar(60)
  capacity  Int      @default(4)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders    Order[]
}

// ---------------------------------------------------------------
//  Órdenes
// ---------------------------------------------------------------

enum OrderStatus {
  OPEN           // mesa con cuenta abierta
  BILL_REQUESTED // pendiente de pago (cuenta solicitada)
  PAID           // pagada y cerrada => venta registrada
  CANCELLED      // anulada (no cuenta como venta)
}

enum OrderItemStatus {
  PENDING
  IN_PREPARATION
  READY
  DELIVERED
  CANCELLED
}

model Order {
  id             Int         @id @default(autoincrement())
  number         Int         @unique @default(autoincrement())
  tableId        Int
  table          DiningTable @relation(fields: [tableId], references: [id])
  waiterId       Int
  waiter         User        @relation("OrderWaiter", fields: [waiterId], references: [id])
  status         OrderStatus @default(OPEN)
  guests         Int         @default(1)
  notes          String?     @db.VarChar(500)

  discountType   String?     @db.VarChar(10) // AMOUNT | PERCENT
  discountValue  Decimal     @default(0) @db.Decimal(12, 2)
  discountReason String?     @db.VarChar(255)

  // Totales congelados al cerrar la cuenta (fuente para reportes)
  subtotal       Decimal     @default(0) @db.Decimal(12, 2)
  discountAmount Decimal     @default(0) @db.Decimal(12, 2)
  serviceAmount  Decimal     @default(0) @db.Decimal(12, 2)
  taxAmount      Decimal     @default(0) @db.Decimal(12, 2)
  total          Decimal     @default(0) @db.Decimal(12, 2)

  openedAt       DateTime    @default(now())
  billRequestedAt DateTime?
  closedAt       DateTime?
  closedById     Int?
  closedBy       User?       @relation("OrderClosedBy", fields: [closedById], references: [id])
  cancelReason   String?     @db.VarChar(255)
  version        Int         @default(0)

  batches        OrderBatch[]
  items          OrderItem[]
  history        OrderHistory[]
  payments       Payment[]

  @@index([tableId, status])
  @@index([waiterId])
  @@index([status, closedAt])
  @@index([openedAt])
}

// Cada envío del mesero genera una "comanda" (batch). Los productos
// nuevos agregados después llegan a cocina/bar como una comanda nueva.
model OrderBatch {
  id          Int         @id @default(autoincrement())
  orderId     Int
  order       Order       @relation(fields: [orderId], references: [id])
  sequence    Int         // 1, 2, 3... dentro de la orden
  createdById Int
  createdBy   User        @relation(fields: [createdById], references: [id])
  createdAt   DateTime    @default(now())
  items       OrderItem[]

  @@unique([orderId, sequence])
}

model OrderItem {
  id            Int             @id @default(autoincrement())
  orderId       Int
  order         Order           @relation(fields: [orderId], references: [id])
  batchId       Int
  batch         OrderBatch      @relation(fields: [batchId], references: [id])
  productId     Int
  product       Product         @relation(fields: [productId], references: [id])
  areaId        Int
  area          PreparationArea @relation(fields: [areaId], references: [id])

  // snapshot al momento de la venta (precios históricos inmutables)
  productName   String          @db.VarChar(120)
  unitPrice     Decimal         @db.Decimal(12, 2)
  quantity      Int
  notes         String?         @db.VarChar(300)
  status        OrderItemStatus @default(PENDING)

  // si es una cancelación parcial de otra línea, apunta a la línea original
  parentItemId  Int?
  parentItem    OrderItem?      @relation("ItemSplit", fields: [parentItemId], references: [id])
  splits        OrderItem[]     @relation("ItemSplit")

  modifiedAt    DateTime?       // última modificación tras ser enviado (alerta en KDS)
  createdById   Int
  createdBy     User            @relation("ItemCreatedBy", fields: [createdById], references: [id])
  createdAt     DateTime        @default(now())
  startedAt     DateTime?
  readyAt       DateTime?
  deliveredAt   DateTime?
  cancelledAt   DateTime?
  cancelledById Int?
  cancelledBy   User?           @relation("ItemCancelledBy", fields: [cancelledById], references: [id])
  cancelReason  String?         @db.VarChar(255)

  history       OrderHistory[]
  paymentItems  PaymentItem[]

  @@index([orderId])
  @@index([areaId, status])
  @@index([batchId])
  @@index([productId])
}

model OrderHistory {
  id          Int        @id @default(autoincrement())
  orderId     Int
  order       Order      @relation(fields: [orderId], references: [id])
  orderItemId Int?
  orderItem   OrderItem? @relation(fields: [orderItemId], references: [id])
  userId      Int
  user        User       @relation(fields: [userId], references: [id])
  action      String     @db.VarChar(40)
  description String     @db.VarChar(500)
  details     Json?
  createdAt   DateTime   @default(now())

  @@index([orderId, createdAt])
}

// ---------------------------------------------------------------
//  Pagos
// ---------------------------------------------------------------

enum PaymentMethodKind {
  CASH
  CARD
  TRANSFER
  OTHER
}

model PaymentMethod {
  id        Int               @id @default(autoincrement())
  code      String            @unique @db.VarChar(30)
  name      String            @db.VarChar(60)
  kind      PaymentMethodKind
  active    Boolean           @default(true)
  sortOrder Int               @default(0)
  payments  Payment[]
  movements CashMovement[]
}

enum PaymentStatus {
  COMPLETED
  VOIDED
}

model Payment {
  id              Int           @id @default(autoincrement())
  orderId         Int
  order           Order         @relation(fields: [orderId], references: [id])
  paymentMethodId Int
  paymentMethod   PaymentMethod @relation(fields: [paymentMethodId], references: [id])
  cashSessionId   Int
  cashSession     CashSession   @relation(fields: [cashSessionId], references: [id])
  amount          Decimal       @db.Decimal(12, 2) // monto aplicado a la cuenta
  receivedAmount  Decimal?      @db.Decimal(12, 2) // efectivo recibido
  changeAmount    Decimal       @default(0) @db.Decimal(12, 2)
  reference       String?       @db.VarChar(120)
  payerLabel      String?       @db.VarChar(60)    // "Persona 1", "Juan"...
  splitMode       String        @default("FULL") @db.VarChar(20) // FULL | EQUAL | ITEMS | CUSTOM
  status          PaymentStatus @default(COMPLETED)
  idempotencyKey  String        @unique @db.VarChar(80) // evita pagos/ventas duplicadas
  userId          Int
  user            User          @relation(fields: [userId], references: [id])
  createdAt       DateTime      @default(now())
  items           PaymentItem[]
  cashMovement    CashMovement?

  @@index([orderId])
  @@index([cashSessionId])
  @@index([createdAt])
}

// Asignación de productos a un pago (división por consumo)
model PaymentItem {
  id          Int       @id @default(autoincrement())
  paymentId   Int
  payment     Payment   @relation(fields: [paymentId], references: [id])
  orderItemId Int
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id])
  quantity    Int
  amount      Decimal   @db.Decimal(12, 2)

  @@index([orderItemId])
}

// ---------------------------------------------------------------
//  Caja
// ---------------------------------------------------------------

model CashRegister {
  id        Int           @id @default(autoincrement())
  name      String        @unique @db.VarChar(60)
  active    Boolean       @default(true)
  sessions  CashSession[]
}

enum CashSessionStatus {
  OPEN
  CLOSED
}

// Apertura de caja
model CashSession {
  id             Int               @id @default(autoincrement())
  registerId     Int
  register       CashRegister      @relation(fields: [registerId], references: [id])
  openedById     Int
  openedBy       User              @relation("CashOpenedBy", fields: [openedById], references: [id])
  openedAt       DateTime          @default(now())
  openingAmount  Decimal           @db.Decimal(12, 2)
  openingNotes   String?           @db.VarChar(500)
  status         CashSessionStatus @default(OPEN)
  closing        CashClosing?
  movements      CashMovement[]
  payments       Payment[]

  @@index([registerId, status])
}

// Cierre de caja (snapshot del arqueo)
model CashClosing {
  id                 Int         @id @default(autoincrement())
  sessionId          Int         @unique
  session            CashSession @relation(fields: [sessionId], references: [id])
  closedById         Int
  closedBy           User        @relation(fields: [closedById], references: [id])
  closedAt           DateTime    @default(now())
  openingAmount      Decimal     @db.Decimal(12, 2)
  totalSales         Decimal     @db.Decimal(12, 2)
  cashSales          Decimal     @db.Decimal(12, 2)
  cardSales          Decimal     @db.Decimal(12, 2)
  transferSales      Decimal     @db.Decimal(12, 2)
  otherSales         Decimal     @db.Decimal(12, 2)
  totalIncome        Decimal     @db.Decimal(12, 2)
  totalWithdrawals   Decimal     @db.Decimal(12, 2)
  totalExpenses      Decimal     @db.Decimal(12, 2)
  totalAdjustments   Decimal     @db.Decimal(12, 2)
  expectedCash       Decimal     @db.Decimal(12, 2)
  countedCash        Decimal     @db.Decimal(12, 2)
  difference         Decimal     @db.Decimal(12, 2)
  notes              String?     @db.VarChar(500)
}

enum CashMovementType {
  SALE
  INCOME
  WITHDRAWAL
  EXPENSE
  ADJUSTMENT
}

model CashMovement {
  id              Int              @id @default(autoincrement())
  sessionId       Int
  session         CashSession      @relation(fields: [sessionId], references: [id])
  type            CashMovementType
  // Positivo = entra dinero, negativo = sale (retiros/gastos se guardan negativos)
  amount          Decimal          @db.Decimal(12, 2)
  paymentMethodId Int?
  paymentMethod   PaymentMethod?   @relation(fields: [paymentMethodId], references: [id])
  paymentId       Int?             @unique
  payment         Payment?         @relation(fields: [paymentId], references: [id])
  description     String           @db.VarChar(255)
  userId          Int
  user            User             @relation("MovementUser", fields: [userId], references: [id])
  authorizedById  Int?
  authorizedBy    User?            @relation("MovementAuthorizedBy", fields: [authorizedById], references: [id])
  createdAt       DateTime         @default(now())

  @@index([sessionId, type])
  @@index([createdAt])
}

// ---------------------------------------------------------------
//  Notificaciones, auditoría y configuración
// ---------------------------------------------------------------

model Notification {
  id        Int       @id @default(autoincrement())
  userId    Int
  user      User      @relation(fields: [userId], references: [id])
  type      String    @db.VarChar(40)
  title     String    @db.VarChar(120)
  message   String    @db.VarChar(500)
  data      Json?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id])
  action    String   @db.VarChar(60)
  entity    String   @db.VarChar(40)
  entityId  String?  @db.VarChar(40)
  details   Json?
  ip        String?  @db.VarChar(60)
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([userId])
  @@index([entity, entityId])
}

model RestaurantSettings {
  id                 Int      @id @default(1)
  name               String   @db.VarChar(120)
  legalName          String?  @db.VarChar(160)
  legalId            String?  @db.VarChar(40)
  address            String?  @db.VarChar(255)
  phone              String?  @db.VarChar(40)
  email              String?  @db.VarChar(120)
  logoUrl            String?  @db.VarChar(500)
  currencyCode       String   @default("CRC") @db.VarChar(3)
  currencySymbol     String   @default("₡") @db.VarChar(4)
  taxRate            Decimal  @default(13) @db.Decimal(5, 2)  // IVA %
  serviceRate        Decimal  @default(10) @db.Decimal(5, 2)  // Servicio %
  pricesIncludeTax   Boolean  @default(false)
  timezone           String   @default("America/Costa_Rica") @db.VarChar(60)
  receiptFooter      String?  @db.VarChar(300)
  kdsWarningMinutes  Int      @default(10)
  kdsCriticalMinutes Int      @default(20)
  updatedAt          DateTime @updatedAt
}
